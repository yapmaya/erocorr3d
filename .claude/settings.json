{
  "permissions": {
    "allow": [
      "Bash(npm run dev*)",
      "Bash(npm run test*)",
      "Bash(npm run build*)",
      "Bash(npm run lint*)",
      "Bash(npx vitest*)",
      "Bash(npx tsc*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)"
    ],
    "ask": [
      "Bash(npm install*)",
      "Bash(npm publish*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r \".tool_input.file_path // .tool_response.filePath // empty\"); case \"$f\" in *.ts|*.tsx) out=$(cd \"${CLAUDE_PROJECT_DIR:-.}\" && npx eslint \"$f\" 2>&1); code=$?; if [ \"$code\" -ne 0 ]; then jq -n --arg r \"$out\" --arg f \"$f\" \"{decision:\\\"block\\\",reason:(\\\"ESLint hatası — \\\" + \\$f + \\\":\\n\\\" + \\$r)}\"; exit 2; fi ;; esac",
            "asyncRewake": true,
            "statusMessage": "ESLint kontrol ediliyor..."
          }
        ]
      }
    ]
  }
}
